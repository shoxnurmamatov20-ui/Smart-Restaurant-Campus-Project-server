APP_NAME="CAMPUS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uz_UZ

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============ DATABASE ============
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=campus
DB_USERNAME=campus
DB_PASSWORD=changeme

# ============ SESSION / CACHE / QUEUE ============
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=campus

MEMCACHED_HOST=127.0.0.1

# ============ REDIS ============
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ============ MAIL ============
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@campus.uz"
MAIL_FROM_NAME="${APP_NAME}"

# ============ S3 / MINIO ============
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=campus
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://127.0.0.1:9000/campus

# ============ SANCTUM (SPA Auth) ============
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,127.0.0.1:3000,127.0.0.1:3001

# ============ REVERB (WebSocket) ============
REVERB_APP_ID=campus-app
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# ============ HORIZON (Queue dashboard) ============
HORIZON_PREFIX=horizon:
HORIZON_DOMAIN=null
HORIZON_PATH=horizon

# ============ SCOUT (Search) ============
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ============ KEYCLOAK (SSO — Phase 2) ============
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=campus
KEYCLOAK_CLIENT_ID=campus-api
KEYCLOAK_CLIENT_SECRET=

# ============ HEMIS INTEGRATION ============
HEMIS_API_URL=https://hemis.uz/api
HEMIS_API_KEY=
HEMIS_UNIVERSITY_ID=

# ============ E-IMZO ============
EIMZO_API_URL=https://e-imzo.uz
EIMZO_CLIENT_ID=
EIMZO_CLIENT_SECRET=

# ============ PAYMENT (Phase 2) ============
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_API_URL=https://checkout.paycom.uz

CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_API_URL=https://api.click.uz

# ============ SMS (Eskiz) ============
ESKIZ_API_URL=https://notify.eskiz.uz
ESKIZ_API_TOKEN=
ESKIZ_FROM=4546

# ============ AI ============
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_SERVICE_URL=http://127.0.0.1:8001

# ============ MONITORING ============
SENTRY_LARAVEL_DSN=
TELESCOPE_ENABLED=true

# ============ MODULES ============
MODULES_NAMESPACE=Modules
MODULES_STUB_ARCHIVED=false

# ============ BACKUP ============
BACKUP_ARCHIVE_PASSWORD=changeme

# ============ CORS ============
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
