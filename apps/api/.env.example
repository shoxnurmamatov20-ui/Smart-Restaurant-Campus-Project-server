APP_NAME="Smart Restaurant Campus API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Where a GUEST lands, which is not where the API lives.
#
# A table's QR code encodes `{GUEST_APP_URL}/qr/{restaurant}/{qr_token}` — a
# route in apps/web, not an endpoint here. The two share a host in development
# and do not in production, and getting it wrong is not a redirect: it is two
# hundred stickers somebody already printed. Defaults to APP_URL.
GUEST_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uz_UZ

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Add `telegram` to LOG_STACK in production (`LOG_STACK=daily,telegram`) and
# fill these from /etc/srcp/alerts.env — `critical` and above reach the
# operations chat. Unset = the channel is silent, never an error.
TELEGRAM_ALERT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_ALERT_LEVEL=critical
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============ DATABASE ============
# PostgreSQL only — every module lives in its own schema (menu, orders,
# kitchen, ...), which no other engine supports. Tests run against
# restaurant_campus_test on the same server; see phpunit.xml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=restaurant_campus
DB_USERNAME=restaurant_campus
DB_PASSWORD=changeme

# `public` must stay first: anything created without an explicit schema — a
# framework table, a package migration we do not own — lands there rather than
# inside a module. Every module schema follows so an unqualified table name
# still resolves. Only override this if you add a module schema.
# DB_SEARCH_PATH=public,menu,orders,kitchen,tables,inventory,suppliers,staff,finance,crm,telegram,analytics,delivery,pos

# ============ SESSION / CACHE / QUEUE ============
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3

# Where dish photographs go (POST /v1/menu/items/{item}/image). Every upload
# becomes three WebP renditions under a sharded, content-hashed key — see
# App\Support\Media — so the disk only ever holds what a screen can show.
#
# Defaults to `public` (storage/app/public, served by nginx from disk under
# /storage with a year of cache), NOT to FILESYSTEM_DISK: a photograph is on a
# public menu by definition and the application's default disk is private.
# Set `s3` to keep them in MinIO/S3 with AWS_* below, and point AWS_URL at the
# CDN in front of the bucket — addresses are built from it at read time, so
# moving later is a config change rather than a row rewrite.
# MENU_IMAGE_DISK=public
#
# The ceilings on one upload: what a phone produces, and what a worker can
# decode. The megapixel ceiling is what bounds memory — a decoded image is
# four bytes per pixel whatever it weighed on disk.
# MENU_IMAGE_MAX_KB=12288
# MENU_IMAGE_MAX_MEGAPIXELS=25
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=restaurant_campus

MEMCACHED_HOST=127.0.0.1

# ============ REDIS ============
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ============ MAIL ============
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@restaurant-campus.uz"
MAIL_FROM_NAME="${APP_NAME}"

# ============ S3 / MINIO ============
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=restaurant-campus
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://127.0.0.1:9000/restaurant-campus

# ============ SANCTUM (SPA Auth) ============
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,127.0.0.1:3000,127.0.0.1:3001

# ============ REVERB (WebSocket) ============
REVERB_APP_ID=restaurant-campus-app
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8020
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8020

# ============ HORIZON (Queue dashboard) ============
HORIZON_PREFIX=horizon:
HORIZON_DOMAIN=null
HORIZON_PATH=horizon

# ============ SCOUT (Search) ============
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ============ KEYCLOAK (SSO — Phase 2) ============
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=restaurant-campus
KEYCLOAK_CLIENT_ID=restaurant-campus-api
KEYCLOAK_CLIENT_SECRET=

# ============ TENANCY ============
TENANCY_MODE=single_database
TENANCY_HEADER=X-Tenant
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,restaurant-campus.uz
TENANCY_DEFAULT_SLUG=demo-restaurant
TENANCY_REQUIRE_TENANT=false

# ============ PIN (kassa va xodimlar ilovasi) ============
#
# Four digits, and the two numbers that make four digits defensible. Ten thousand
# combinations fall in seconds to a machine and take weeks against five tries and
# a fifteen-minute door.
#
# One counter, shared. A till and a staff phone ask the same person for the same
# PIN, so the lockout lives on the person — `public.user_pins` — rather than once
# per surface. Two counters would mean ten guesses instead of five, and the phone
# is the surface somebody can walk away with.
#
# Raising max_attempts is the one change here that costs security rather than
# convenience: it multiplies the guess budget directly.
AUTH_PIN_MAX_ATTEMPTS=5
AUTH_PIN_LOCK_MINUTES=15

# ============ ZAXIRA NUSXA (backups) ============
#
# `spatie/laravel-backup` was a dependency from the start and nothing ever ran
# it: the commands were never scheduled, so a disk loss destroyed every order,
# payment, shift and Z-report with no copy anywhere. `routes/console.php` now
# runs backup:run, backup:clean and backup:monitor daily.
#
# `local` writes into storage/app — the same disk as the database, which is not
# a backup of the failure it is for. Add a second destination and every copy
# stops dying with the box it protects:
#
#   BACKUP_DISKS=local,s3
#
# with AWS_* filled in below. `continue_on_failure` is true, so an unreachable
# off-site target never throws away the local copy that succeeded.
BACKUP_DISKS=local

# Where a FAILED backup is emailed. Empty is fine and is the default: with no
# address spatie sends nothing, and `srcp-health` still alerts through
# `srcp-notify` when the newest dump ages past a day — which catches every way a
# backup stops, including the scheduler dying. Filling this in adds a second
# channel; it does not replace the first.
BACKUP_NOTIFY_EMAIL=


# How long a till session may sit idle before the server closes it. This one IS
# the POS's own — a phone in somebody's pocket is not an unattended till.
POS_SESSION_IDLE_MINUTES=15

# ============ FISCAL MODULE (O'zbekiston onlayn-kassa) ============
#
# These four names are what the code actually reads. The file previously
# documented FISCAL_PROVIDER / FISCAL_API_URL / FISCAL_TERMINAL_ID / FISCAL_TOKEN,
# and NOTHING read any of them — so an operator who filled those in went live
# believing every sale was being declared, while the driver stayed `none` and each
# receipt sat in the queue until its 24-hour window closed. Silent, and by the time
# it surfaces it is a tax problem rather than a configuration one.
#
# Off by default. A restaurant that has not been issued a module number is not
# fiscalised, and pretending otherwise is worse than saying so.
FINANCE_FISCAL_ENABLED=false

# `none` records nothing. `demo` is a local stand-in that REFUSES to construct in
# production, so it cannot be left on by accident. `soliq` and `multibank` are the
# real thing: both build Modules\Finance\Fiscal\HttpOfdDriver, which differs
# between operators only by two paths and four field names — all of them below.
FISCAL_DRIVER=none

# The number the tax authority issued for this till. At least 8 digits; the probe
# endpoint checks the shape and says so, because a typo here is a restaurant that
# looks connected and declares nothing.
FISCAL_MODULE_NO=

# How long a receipt may stay unfiled before it stops being a retry and becomes a
# correction. 24 hours is the authority's own window.
FISCAL_WINDOW_HOURS=24

# Where the OFD is, and the key it issued. With either of them empty the driver
# reports itself unavailable and receipts queue — which is exactly the state a
# restaurant is in between signing with an operator and being given credentials.
# `GET /api/v1/finance/fiscal/probe` says which of the two is missing.
FISCAL_OFD_URL=https://ofd.soliq.uz/api/v1
FISCAL_OFD_TOKEN=
FISCAL_OFD_REGISTER_PATH=/receipts
FISCAL_OFD_STATUS_PATH=/status

# The operator's own names for what comes back. Defaults match the demo driver,
# so a wrong name here surfaces as "no fiscal sign in the answer" rather than as
# a receipt carrying an empty one.
FISCAL_OFD_FIELD_SIGN=fiscal_sign
FISCAL_OFD_FIELD_SEQ=receipt_seq
FISCAL_OFD_FIELD_QR=qr_url
FISCAL_OFD_FIELD_ERROR_CODE=error_code
FISCAL_OFD_FIELD_ERROR_MESSAGE=error_message

# ============ E-IMZO ============
EIMZO_API_URL=https://e-imzo.uz
EIMZO_CLIENT_ID=
EIMZO_CLIENT_SECRET=

# ============ ONLINE PAYMENTS (Payme · Click · Uzum) ============
#
# These names are what the code actually reads. The file previously documented
# PAYME_SECRET_KEY and nothing read it — the same trap the fiscal block above
# describes, and worse here: an operator who filled it in would ship a checkout
# whose Payme button opened a merchant id of `` and failed after the guest had
# committed to paying.
#
# A provider with an empty credential is OFF, not broken. Most venues sign with
# one acquirer and never with all three, so the registry reports it as
# `available: false`, the checkout draws one fewer button, and nothing throws.
# `GET /api/v1/payments/providers` is where an owner sees which are which.

# Payme (Paycom) Merchant API — JSON-RPC, and WE are the server. `PAYME_KEY` is
# the merchant key Payme presents as HTTP Basic `Paycom:<key>` on every
# callback: there is no signature over the body, so this string is the entire
# wall between a genuine PerformTransaction and a stranger posting JSON.
PAYME_ENABLED=true
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_API_URL=https://checkout.paycom.uz/api
# The field name the merchant cabinet was configured to send the account in.
# Hard-coding `order_id` breaks every venue that chose otherwise — silently: the
# checkout opens and Payme asks about a field we never send.
PAYME_ACCOUNT_FIELD=order_id

# Click — Prepare/Complete callbacks signed with MD5 over eight ordered fields.
# `CLICK_MERCHANT_USER_ID` is needed only for reversals through the Merchant API.
CLICK_ENABLED=true
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay
CLICK_API_URL=https://api.click.uz/v2/merchant

# Uzum Bank. Off by default and it should stay off until somebody has read the
# integration contract: the driver's field names are an assumption, and it says
# so in its own docblock rather than pretending otherwise.
UZUM_ENABLED=false
UZUM_MERCHANT_ID=
UZUM_SERVICE_ID=
UZUM_SECRET_KEY=
UZUM_CHECKOUT_URL=https://www.uzumbank.uz/open-service
UZUM_API_URL=

# The laptop's provider: marks the invoice paid the moment it is created, so the
# whole flow can be walked without a bank. It REFUSES TO CONSTRUCT IN PRODUCTION
# — a rail that reports payment without taking any is a restaurant giving food
# away while its dashboard says it was paid.
PAYMENTS_SANDBOX_ENABLED=false

# ============ SMS (Eskiz) ============
# `log` writes the message to storage/logs and sends nothing — the driver a
# laptop and CI run, and the only way to read a sign-in code locally. `eskiz`
# is the real gateway; selecting it with any of the three below empty stops the
# application at boot rather than at the first sign-in attempt.
SMS_DRIVER=log
SMS_FROM=4546
SMS_ESKIZ_URL=https://notify.eskiz.uz
# Eskiz has no API key: an email and a password are exchanged for a token that
# lives a month. Both are account credentials — never commit real ones.
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=

# A fixed sign-in code, for automated browser tests. Empty means random, which
# is the only setting a server may ever have — `OtpCredentials::fixedCode()`
# ignores this outside `local` and `testing` no matter what is written here, and
# a test locks that. Set it to four digits to let the customer journey spec sign
# a guest in without reading storage/logs.
OTP_TEST_CODE=

# ============ AI ============
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_SERVICE_URL=http://127.0.0.1:8001

# ============ TELEGRAM BOTS (shared with apps/telegram-bots) ============
# This token MUST match LARAVEL_INTERNAL_TOKEN in apps/telegram-bots/.env.
# Generate once: php artisan telegram:rotate-token
# Run `php artisan telegram:check-config` to verify both sides are in sync.
TELEGRAM_INTERNAL_TOKEN=
TELEGRAM_BOTS_SERVICE_URL=http://localhost:8002
# Bot endpoints backed by modules that are still skeletons return placeholder
# data while true. Set to false in production so they return HTTP 501 instead
# of an invented bonus balance.
TELEGRAM_MOCK_DATA=true

# ============ MONITORING ============
SENTRY_LARAVEL_DSN=
TELESCOPE_ENABLED=true

# ============ MODULES ============
MODULES_NAMESPACE=Modules
MODULES_STUB_ARCHIVED=false

# ============ BACKUP ============
BACKUP_ARCHIVE_PASSWORD=changeme

# ============ CORS ============
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============ POS ============
#
# How long a manager's signature stays spendable. Ten minutes: long enough for a
# phone to be answered from the car park, short enough that a signature cannot be
# collected quietly and saved for later. It is not the only guard — an approval is
# bound to the action, the subject AND the amount, and is spent once.
POS_APPROVAL_TTL_MINUTES=10

# How long a pairing code is good for. A code read off a screen and typed into a
# tablet in the same minute; anything longer is a code left on a counter.
POS_PAIRING_TTL_MINUTES=15

# Expo push (optional until "enhanced push security" is turned on for the project)
EXPO_ACCESS_TOKEN=
