includes:
    - vendor/larastan/larastan/extension.neon

    # 128 errors, down from the 721 this configuration reported the first time it
    # actually ran. The difference is `ide-helper:models --write` across all 44
    # models in app/ and Modules/*/app/: 593 of the original errors were
    # `property.notFound`, which is PHPStan saying it cannot see a column that has
    # no @property docblock rather than anything being wrong.
    #
    # What is left was read, not just counted. Roughly half is `nullsafe.neverNull`
    # — `?->` on something the schema says is NOT NULL — and most of the rest is
    # defensive code the annotations have now made provably redundant, such as
    # `$this->expires_at !== null` on a non-nullable column. Checked against
    # information_schema rather than assumed: the annotation is right and the
    # check is dead, which is harmless and stays until someone makes that column
    # nullable and needs it again.
    #
    # To burn the rest down: delete entries, run, fix what surfaces. Never
    # regenerate this file to make a new error disappear — that is the one move
    # that turns a debt register into a place bugs go to hide.
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - app
        - Modules
        - database
        - routes
    excludePaths:
        - vendor
        - bootstrap/cache
        - storage
        - Modules/*/vendor
    # These two were `checkMissingIterableValueType: false` and
    # `checkGenericClassInNonGenericObjectType: false`, which PHPStan removed in
    # 2.0. larastan ^3.0 requires PHPStan ^2.0, so every run since that
    # dependency was chosen died with "Invalid configuration: Unexpected item"
    # before analysing a single file — the quality gate was not failing, it was
    # not running.
    #
    # 2.0 replaced both flags with error identifiers, so the intent is expressed
    # by ignoring those identifiers instead. Same effect, and a `array` without a
    # value type still shows up under `--error-format=table` if the ignore is
    # ever lifted.
    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics

        # `$this->command?->info(...)` inside a seeder.
        #
        # Laravel types `Seeder::$command` as non-nullable, so the nullsafe reads as
        # unnecessary — and it is not: a seeder invoked from code rather than from
        # the console (`$this->seed(X::class)` in a test, an installer calling
        # Artisan::call) has no command attached, and `->info()` on null is fatal.
        # Dropping the `?` would break every test that seeds. `isset()` reports the
        # same false positive, so there is no phrasing that satisfies both the
        # analyser and the runtime.
        #
        # One rule rather than a baseline entry per file: it was 22 of them, one for
        # every seeder in the project, and the next seeder would have made 23. A
        # baseline that grows by one file per feature is a baseline nobody reads,
        # and the entries it hides among become invisible.
        -
            message: '#^Using nullsafe method call on non\-nullable type Illuminate\\Console\\Command\. Use \-\> instead\.$#'
            identifier: nullsafe.neverNull
            path: database/seeders/*.php
        -
            message: '#^Using nullsafe method call on non\-nullable type Illuminate\\Console\\Command\. Use \-\> instead\.$#'
            identifier: nullsafe.neverNull
            path: Modules/*/database/seeders/*.php

        # larastan only recognises the application's own `config/` directory, so
        # every module's config file is reported as an env() call made outside
        # config — which would indeed return null once the config is cached.
        #
        # Checked before suppressing, rather than assumed: with the cache in
        # place, `config('pos')` resolves 28 keys and none of them is null,
        # because ServiceProvider::mergeConfigFrom() skips the merge entirely
        # when the configuration is cached, so the values baked in at cache time
        # are the ones served. These files are config; they are just not in the
        # one directory larastan looks at.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: Modules/*/config/*.php

        # The two error-envelope assertions are TestResponse macros, registered
        # in Tests\TestCase. A macro is a closure in a static array reached
        # through __call, so PHPStan cannot see it.
        #
        # A stub was tried first and rejected: a PHPStan stub REPLACES the class
        # it names, and Illuminate\Testing\TestResponse is generic and
        # implements ArrayAccess, so a two-method stub does not merge. Naming
        # the two methods exactly — rather than silencing method.notFound on the
        # whole file — keeps a misspelled assertion failing, which is the only
        # thing this suppression could otherwise hide.
        -
            message: '#Call to an undefined method .*TestResponse::assertApi(Error|ValidationErrors)\(\)#'
            path: Modules/*/tests/*
