# Generated by `expo prebuild` from app.json — never hand-edited, never committed.
# The native projects are a build artefact of the config, the same way .next is
# of the source; keeping them would mean two places to change a permission.
/android
/ios

# Expo CLI state and the export output `pnpm build` writes.
/.expo
/dist
expo-env.d.ts

# Never the keystore. It lives in ~/.srcp-android/ with its password; a key in
# the repo is a key in every clone, and an APK signed with it can be replaced
# on every phone that installed one.
*.keystore
*.jks
