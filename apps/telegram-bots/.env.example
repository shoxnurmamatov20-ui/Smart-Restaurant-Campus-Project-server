APP_NAME="CAMPUS Telegram Bots"
APP_ENV=local
APP_DEBUG=true

# Webhook host
HOST=0.0.0.0
PORT=8002

# Public webhook base URL (Telegram pings this)
# In dev use ngrok / cloudflared
PUBLIC_WEBHOOK_URL=https://your-tunnel.example.com

# Webhook secret token (sent in X-Telegram-Bot-Api-Secret-Token header)
WEBHOOK_SECRET_TOKEN=changeme-please-generate-a-long-random-string

# Database (READ-ONLY analytics; writes go via Laravel API)
DATABASE_URL=postgresql+asyncpg://campus:changeme@localhost:5432/campus

# Redis (FSM storage, rate limit) — DB 3 to avoid clash with Laravel and AI Services
REDIS_URL=redis://localhost:6379/3

# Laravel API
LARAVEL_API_URL=http://localhost:8000/api/v1
LARAVEL_INTERNAL_TOKEN=                   # generated by Laravel; bot uses it for internal calls

# Default i18n
DEFAULT_LOCALE=uz
SUPPORTED_LOCALES=uz,ru,en

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true

# ============ Bot tokens ============
# Each bot has its own token. Set ONLY for bots you want to actually run.
# Bots without a token will be skipped on startup (warning logged).
#
# Get tokens from @BotFather:
#   /newbot → choose name → choose username → receive token

BOT_TOKEN_STUDENT=
BOT_TOKEN_PARENT=
BOT_TOKEN_TEACHER=
BOT_TOKEN_HR=
BOT_TOKEN_LIBRARY=
BOT_TOKEN_CAFETERIA=
BOT_TOKEN_TRANSPORT=
BOT_TOKEN_HELPDESK=
BOT_TOKEN_EDMS=
BOT_TOKEN_RECTOR=

# Phase 2 — leave empty until ready
BOT_TOKEN_SMART_CLASSROOM=
BOT_TOKEN_EXAM_PROCTOR=
BOT_TOKEN_ALUMNI=
BOT_TOKEN_ANONYMOUS_TIP=
BOT_TOKEN_DORMITORY=
BOT_TOKEN_PARKING=
BOT_TOKEN_SECURITY=
BOT_TOKEN_SPORTS=
BOT_TOKEN_NEW_BOOKS=
BOT_TOKEN_SCHOLARSHIPS=
BOT_TOKEN_RESEARCH=
BOT_TOKEN_CONFERENCES=
BOT_TOKEN_DIPLOMAS=
BOT_TOKEN_INTERNSHIP=
BOT_TOKEN_CAREER=
BOT_TOKEN_MASTERCLASS=
BOT_TOKEN_MENTAL_HEALTH=
BOT_TOKEN_EMERGENCY=
BOT_TOKEN_WEATHER=
BOT_TOKEN_LANGUAGE_PAIR=

# Per-fakultet bots (8)
BOT_TOKEN_FAC_IT=
