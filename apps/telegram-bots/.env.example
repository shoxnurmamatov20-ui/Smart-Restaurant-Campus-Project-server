APP_NAME="Smart Restaurant Campus Telegram Bots"
APP_ENV=local
APP_DEBUG=true

# Webhook host
HOST=0.0.0.0
PORT=8002

# Public webhook base URL (Telegram pings this)
# In dev use ngrok / cloudflared
PUBLIC_WEBHOOK_URL=https://your-tunnel.example.com

# Webhook secret token (sent in X-Telegram-Bot-Api-Secret-Token header)
WEBHOOK_SECRET_TOKEN=changeme-please-generate-a-long-random-string

# Database (READ-ONLY analytics; writes go via the Laravel API)
DATABASE_URL=postgresql+asyncpg://restaurant_campus:changeme@localhost:5432/restaurant_campus

# Redis (FSM storage, rate limit) — DB 3 to avoid clash with Laravel and AI Services
REDIS_URL=redis://localhost:6379/3

# Laravel API
LARAVEL_API_URL=http://localhost:8000/api/v1
# MUST match TELEGRAM_INTERNAL_TOKEN in apps/api/.env (Laravel side).
# Generate once: cd apps/api && php artisan telegram:rotate-token
# Verify both sides in sync: cd apps/api && php artisan telegram:check-config
LARAVEL_INTERNAL_TOKEN=

# Default i18n
DEFAULT_LOCALE=uz
SUPPORTED_LOCALES=uz,ru,en

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true

# ============ Bot tokens ============
# Each bot has its own token. Set ONLY for bots you want to actually run.
# Bots without a token are skipped on startup (warning logged).
#
# Get tokens from @BotFather:
#   /newbot → choose name → choose username → receive token

# ---- Phase 1 — the ten a restaurant needs from day one ----
BOT_TOKEN_GUEST=
BOT_TOKEN_WAITER=
BOT_TOKEN_KITCHEN=
BOT_TOKEN_COURIER=
BOT_TOKEN_MANAGER=
BOT_TOKEN_OWNER=
BOT_TOKEN_LOYALTY=
BOT_TOKEN_RESERVATION=
BOT_TOKEN_FEEDBACK=
BOT_TOKEN_SUPPLIER=

# ---- Phase 2 — operatsion (10) ----
BOT_TOKEN_STOCK_ALERT=
BOT_TOKEN_WASTE=
BOT_TOKEN_HACCP=
BOT_TOKEN_SHIFT_SWAP=
BOT_TOKEN_PAYROLL=
BOT_TOKEN_TRAINING=
BOT_TOKEN_RECRUITING=
BOT_TOKEN_EQUIPMENT=
BOT_TOKEN_ENERGY=
BOT_TOKEN_SECURITY=

# ---- Phase 2 — marketing va mehmon (10) ----
BOT_TOKEN_BIRTHDAY=
BOT_TOKEN_WINBACK=
BOT_TOKEN_CATERING=
BOT_TOKEN_CORPORATE=
BOT_TOKEN_GIFT_CARD=
BOT_TOKEN_REVIEW_WATCH=
BOT_TOKEN_MENU_AI=
BOT_TOKEN_NUTRITION=
BOT_TOKEN_ALLERGEN=
BOT_TOKEN_QUEUE=

# ---- Phase 2 — yetkazib berish (4) ----
BOT_TOKEN_AGGREGATOR=
BOT_TOKEN_DELIVERY_ZONE=
