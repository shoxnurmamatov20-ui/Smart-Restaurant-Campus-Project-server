APP_NAME="Smart Restaurant Campus AI Services"
APP_ENV=local
APP_DEBUG=true

# Server
HOST=0.0.0.0
PORT=8001

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]

# Database (async)
DATABASE_URL=postgresql+asyncpg://restaurant_campus:changeme@localhost:5432/restaurant_campus

# Redis (use DB 2 to avoid clash with Laravel)
REDIS_URL=redis://localhost:6379/2

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-6
AI_FALLBACK_MODEL=gpt-4o-mini

# Laravel API (for callbacks)
LARAVEL_API_URL=http://localhost:8000/api/v1
LARAVEL_INTERNAL_TOKEN=

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=true
