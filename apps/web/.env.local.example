# ============ apps/web ============
# Copy to .env.local and fill in values

NEXT_PUBLIC_APP_NAME="Restaurant Campus"
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Which restaurant this deployment serves by default (tenant slug).
# The API also accepts it per-request via the X-Tenant header.
NEXT_PUBLIC_DEFAULT_TENANT=demo-restaurant

# NextAuth / Auth.js (if used)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Generate: openssl rand -base64 32

# ---------------------------------------------------------------------
# Realtime (Laravel Reverb)
#
# The kitchen display and the floor listen on a WebSocket; nginx upgrades
# `/app/<key>` onto Reverb on this same host. Only the key is needed here — the
# host, port and scheme are taken from whatever origin served the page, so one
# build works over the LAN IP and over the domain with TLS.
#
# Deliberately NOT a NEXT_PUBLIC_ variable. Those are inlined at build time, and
# an operator rotating the key should be restarting the console, not rebuilding
# it. Read per request by src/lib/realtime-server.ts.
#
# It must be the same value as REVERB_APP_KEY in apps/api/.env — two processes
# reading one broadcaster. A mismatch shows up as screens that connect and then
# hear nothing, which is the hardest of the three failures to diagnose.
#
# Unset is a supported state: every screen still renders, the live ones just do
# not move on their own.
REVERB_APP_KEY=

# Only when Reverb is not behind the same nginx that served the page.
# REVERB_PUBLIC_HOST=
# REVERB_PUBLIC_PORT=
# REVERB_PUBLIC_SCHEME=
