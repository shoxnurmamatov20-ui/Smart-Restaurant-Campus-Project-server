# Where a failure goes — copied to /etc/srcp/alerts.env and filled in.
#
#   install -d -m 0750 /etc/srcp
#   install -m 0600 alerts.env.example /etc/srcp/alerts.env
#   $EDITOR /etc/srcp/alerts.env
#   srcp-notify --test        # a message should arrive in the chat
#
# 0600 and root-owned: a bot token is a credential that can post as the
# restaurant's own bot. It is deliberately NOT in shared/env/api.env — that file
# is read by the application, and nothing in the application needs to alert.
#
# With these unset every notifier still runs and exits cleanly, logging one line
# saying it is unconfigured. That is the design: a monitoring channel that broke
# a deploy because nobody had filled in a chat id would be worse than the
# silence it replaces. Check with `journalctl -t srcp-notify`.

# From @BotFather. A dedicated bot, not one of the fifty customer-facing ones:
# an operations channel should not stop working because a marketing bot's token
# was rotated.
SRCP_ALERT_TELEGRAM_TOKEN=

# The group or channel id, with the leading minus for a group.
# Get it by adding the bot to the chat and reading
#   https://api.telegram.org/bot<TOKEN>/getUpdates
SRCP_ALERT_CHAT_ID=
