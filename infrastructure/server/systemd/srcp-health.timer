# Fires srcp-health.service every five minutes.
#
# Five rather than one: the check makes four HTTP requests, three database
# queries and boots artisan twice, which is a second or two of real work. At one
# minute that is a measurable share of a small box spent asking whether the box
# is fine. Five minutes is well inside the window in which a restaurant would
# notice anyway, and the gap costs nothing that matters — a till that fails at
# 19:02 is reported by 19:05 instead of 19:03.
#
# OnUnitActiveSec rather than OnCalendar, and deliberately the opposite choice
# from srcp-scheduler.timer. The scheduler has a contract with wall-clock
# minutes; this has none, and counting from the end of the last run means a slow
# check under load spaces itself out instead of queueing behind itself.

[Unit]
Description=SRCP health check, every five minutes
Documentation=file:///srv/srcp/current/infrastructure/server/systemd/srcp-health.service

[Timer]
# One minute after boot, then every five. The delay is not politeness: php-fpm
# and two Next.js servers need a moment to bind, and a check that runs the
# instant multi-user.target is reached reports a failure that resolves itself
# three seconds later — which is how a monitor teaches people to ignore it.
OnBootSec=1min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=srcp-health.service

# False, for the same reason as the scheduler: a box that was switched off does
# not need to be told it was unhealthy while it was off.
Persistent=false

[Install]
WantedBy=timers.target
