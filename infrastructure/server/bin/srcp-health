#!/usr/bin/env bash
#=============================================================================
# srcp-health — is the platform actually serving?
#
#   srcp-health              # full report
#   srcp-health --quiet      # silent unless something is wrong; exit code says it
#
# Used three ways: by a person after a change, by srcp-deploy to decide whether
# to keep a release or roll it back, and by anything that wants to alert.
#
# The distinction it is built around: "the service is running" and "the service
# is working" are different questions, and systemd only answers the first. A
# Next.js process that boots and then fails every request is `active (running)`.
# So every check here goes through the same path a till does.
#
# CRIT means the platform is not serving and something must be done now.
# WARN means it is serving and something will bite later.
#
# Exit codes: 0 all well (warnings allowed), 1 at least one critical failure.
#=============================================================================
set -uo pipefail

QUIET=0
[[ ${1:-} == --quiet ]] && QUIET=1

readonly SHARED=/srv/srcp/shared
readonly CURRENT=/srv/srcp/current
readonly HOSTHDR=mypos.tashmedunitf.uz

CRIT=0
WARN=0
OUT=""

emit() { OUT+="$1"$'\n'; }
pass() { emit "$(printf '  \033[0;32m✓\033[0m  %-34s %s' "$1" "${2:-}")"; }
warn() { emit "$(printf '  \033[0;33m!\033[0m  %-34s %s' "$1" "${2:-}")"; WARN=$((WARN+1)); }
crit() { emit "$(printf '  \033[0;31m✗\033[0m  %-34s %s' "$1" "${2:-}")"; CRIT=$((CRIT+1)); }

envval() {
    # Reads one key out of the API's environment file. Quotes are stripped
    # because Laravel accepts them and this does not.
    sed -nE "s/^$1=[\"']?([^\"']*)[\"']?[[:space:]]*$/\1/p" "$SHARED/env/api.env" 2>/dev/null | head -1
}

# Artisan has to run as the service account so it can read the release and the
# environment file. When this is invoked with sudo — which is how srcp-deploy
# calls it — that means dropping privileges; when a member of the srcp group
# runs it directly, they already are the right identity.
as_app() {
    if [[ $EUID -eq 0 ]]; then runuser -u srcp -- "$@"; else "$@"; fi
}

#-----------------------------------------------------------------------------
emit $'\n\033[1mRelease\033[0m'
#-----------------------------------------------------------------------------
if [[ -L $CURRENT ]] && target=$(readlink -f "$CURRENT") && [[ -d $target ]]; then
    pass "current release" "$(basename "$target")"
    [[ -f $target/RELEASE ]] && emit "$(printf '     %s' "$(grep -E '^(git_commit|git_dirty)' "$target/RELEASE" | tr '\n' ' ')")"
else
    crit "current release" "${CURRENT} does not resolve to a directory"
fi

#-----------------------------------------------------------------------------
emit $'\n\033[1mServices\033[0m'
#-----------------------------------------------------------------------------
for unit in srcp-web.service srcp-admin.service srcp-horizon.service; do
    state=$(systemctl is-active "$unit" 2>/dev/null)
    if [[ $state == active ]]; then
        since=$(systemctl show -p ActiveEnterTimestamp --value "$unit" 2>/dev/null | cut -d' ' -f2-3)
        pass "$unit" "since $since"
    else
        crit "$unit" "$state"
    fi
done

if [[ $(systemctl is-active srcp-scheduler.timer 2>/dev/null) == active ]]; then
    nxt=$(systemctl show -p NextElapseUSecRealtime --value srcp-scheduler.timer 2>/dev/null)
    pass "srcp-scheduler.timer" "next tick pending"
else
    # Not critical for a single request, but it is what runs the domain event
    # outbox — orders stop propagating and nothing reports an error.
    crit "srcp-scheduler.timer" "inactive — the event outbox is not being relayed"
fi

PHPV=$(find /etc/php -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null | sort -V | tail -1)
if [[ $(systemctl is-active "php$PHPV-fpm" 2>/dev/null) == active ]]; then
    pass "php$PHPV-fpm" "$(pgrep -c -f 'php-fpm: pool srcp' 2>/dev/null || echo 0) worker(s) in pool srcp"
else
    crit "php$PHPV-fpm" "not running — the API cannot answer at all"
fi

[[ $(systemctl is-active nginx 2>/dev/null) == active ]] && pass nginx || crit nginx "not running"

#-----------------------------------------------------------------------------
emit $'\n\033[1mThrough nginx\033[0m'
#-----------------------------------------------------------------------------
http() {
    curl -s -o /dev/null -w '%{http_code} %{time_total}' --max-time 15 \
        -H "Host: $HOSTHDR" -H 'X-Forwarded-Proto: https' "http://127.0.0.1$1" 2>/dev/null
}

check_http() {
    local label=$1 path=$2 want=$3
    read -r code secs <<<"$(http "$path")"
    if [[ $code =~ ^$want$ ]]; then
        pass "$label" "$code in ${secs}s"
    else
        crit "$label" "got ${code:-no response} (wanted $want)"
    fi
}

check_http "GET /up          (Laravel)"  /up      '200'
check_http "GET /            (staff)"    /        '2[0-9][0-9]|3[0-9][0-9]'
check_http "GET /admin       (platform)" /admin   '2[0-9][0-9]|3[0-9][0-9]'

ping_body=$(curl -s --max-time 5 http://127.0.0.1/fpm-ping 2>/dev/null)
[[ $ping_body == pong ]] && pass "php-fpm ping" "pong" || crit "php-fpm ping" "got '${ping_body:-nothing}'"

#-----------------------------------------------------------------------------
emit $'\n\033[1mData stores\033[0m'
#-----------------------------------------------------------------------------
redis_pw=$(envval REDIS_PASSWORD)
if [[ $(redis-cli ${redis_pw:+-a "$redis_pw"} --no-auth-warning ping 2>/dev/null) == PONG ]]; then
    used=$(redis-cli ${redis_pw:+-a "$redis_pw"} --no-auth-warning info memory 2>/dev/null | sed -nE 's/used_memory_human:(.*)\r?/\1/p')
    maxm=$(redis-cli ${redis_pw:+-a "$redis_pw"} --no-auth-warning config get maxmemory 2>/dev/null | tail -1)
    if [[ ${maxm:-0} == 0 ]]; then
        warn "redis" "${used:-?} used, no maxmemory set — an unbounded cache can take the box down"
    else
        pass "redis" "${used:-?} used of $((maxm / 1024 / 1024))MB"
    fi
else
    crit "redis" "not answering — sessions, cache and the queue are all down"
fi

db_pw=$(envval DB_PASSWORD); db_user=$(envval DB_USERNAME); db_name=$(envval DB_DATABASE)
db_host=$(envval DB_HOST);   db_port=$(envval DB_PORT)
if out=$(PGPASSWORD="$db_pw" psql -h "${db_host:-127.0.0.1}" -p "${db_port:-5432}" \
        -U "$db_user" -d "$db_name" -tAc \
        "SELECT pg_size_pretty(pg_database_size(current_database()));" 2>&1); then
    pass "postgresql" "$db_name, $out"
else
    crit "postgresql" "$(echo "$out" | head -1)"
fi

#-----------------------------------------------------------------------------
emit $'\n\033[1mQueue\033[0m'
#-----------------------------------------------------------------------------
if [[ -d $CURRENT ]]; then
    hstatus=$(as_app php "$CURRENT/apps/api/artisan" horizon:status 2>/dev/null | tr -d '\r')
    case "$hstatus" in
        *running*)  pass "horizon" "running" ;;
        *paused*)   warn "horizon" "paused — jobs are queuing and not being worked" ;;
        *)          crit "horizon" "${hstatus:-no answer}" ;;
    esac

    failed=$(as_app php "$CURRENT/apps/api/artisan" queue:failed 2>/dev/null | grep -cE '^\s*\|?\s*[0-9a-f]{8}-' || true)
    if [[ ${failed:-0} -gt 0 ]]; then
        warn "failed jobs" "$failed waiting in the failed table"
    else
        pass "failed jobs" "none"
    fi

    # The outbox. Rows here are domain events written inside the transaction
    # that changed something and relayed afterwards by the scheduler. A backlog
    # means the relay is not running, and nothing else reports that.
    unpub=$(PGPASSWORD="$db_pw" psql -h "${db_host:-127.0.0.1}" -p "${db_port:-5432}" \
        -U "$db_user" -d "$db_name" -tAc \
        "SELECT count(*) FROM domain_events WHERE published_at IS NULL;" 2>/dev/null)
    if [[ ${unpub:-0} -gt 100 ]]; then
        crit "event outbox" "$unpub unpublished — the relay is not keeping up"
    elif [[ ${unpub:-0} -gt 0 ]]; then
        warn "event outbox" "$unpub unpublished"
    else
        pass "event outbox" "empty"
    fi
fi

#-----------------------------------------------------------------------------
emit $'\n\033[1mCapacity\033[0m'
#-----------------------------------------------------------------------------
read -r disk_use disk_avail < <(df --output=pcent,avail / | tail -1 | tr -d '%' | awk '{print $1, $2}')
if   (( disk_use >= 90 )); then crit "disk /" "${disk_use}% used, $((disk_avail/1024/1024))GB free"
elif (( disk_use >= 80 )); then warn "disk /" "${disk_use}% used, $((disk_avail/1024/1024))GB free"
else                            pass "disk /" "${disk_use}% used, $((disk_avail/1024/1024))GB free"; fi

read -r mem_total mem_avail < <(free -m | awk '/^Mem:/ {print $2, $7}')
mem_pct=$(( (mem_total - mem_avail) * 100 / mem_total ))
swap_used=$(free -m | awk '/^Swap:/ {print $3}')

# Swap OCCUPANCY is not thrashing, and reporting it as such is worse than not
# reporting it at all.
#
# This read `swap_used > 512` and called it critical. A release build pushes a
# gigabyte into swap and Linux never proactively pages it back — so a box that
# swapped once during a deploy, recovered, and has four gigabytes free reads as
# "thrashing" forever, on every run, until someone reboots. Two runs of that and
# the whole report gets ignored, which costs more than the check ever saved.
#
# Thrashing is swap ACTIVITY: pages moving in and out right now. vmstat's second
# sample is the live one — the first is an average since boot and would carry
# that same build forever.
read -r swap_in swap_out < <(vmstat 1 2 2>/dev/null | tail -1 | awk '{print $7, $8}')
swap_rate=$(( ${swap_in:-0} + ${swap_out:-0} ))

if   (( swap_rate > 1024 )); then
    crit "memory" "${mem_pct}% used, paging ${swap_rate}MB/s — the box is thrashing"
elif (( mem_pct >= 90 )); then
    warn "memory" "${mem_pct}% used, only ${mem_avail}MB available"
elif (( swap_used > 512 )); then
    # Occupied but quiet: worth knowing, not worth waking anyone for.
    warn "memory" "${mem_pct}% used, ${mem_avail}MB available, ${swap_used}MB sitting in swap"
else
    pass "memory" "${mem_pct}% used, ${mem_avail}MB available"
fi

rel_count=$(find /srv/srcp/releases -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
pass "releases kept" "$rel_count in /srv/srcp/releases ($(du -sh /srv/srcp/releases 2>/dev/null | cut -f1))"

#-----------------------------------------------------------------------------
# Report
#-----------------------------------------------------------------------------
if (( CRIT > 0 )); then
    printf '%s' "$OUT"
    printf '\n\033[0;31m✗ %d critical, %d warning(s)\033[0m — the platform is not fully serving\n\n' "$CRIT" "$WARN"
    exit 1
fi

if (( QUIET )); then
    exit 0
fi

printf '%s' "$OUT"
if (( WARN > 0 )); then
    printf '\n\033[0;33m✓ serving, with %d warning(s)\033[0m\n\n' "$WARN"
else
    printf '\n\033[0;32m✓ all checks passed\033[0m\n\n'
fi
exit 0
