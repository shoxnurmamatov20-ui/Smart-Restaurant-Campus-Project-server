# ---------- Environment ----------
# Everything but the checked-in templates. The apps used to carry their own
# .gitignore repeating this; one rule here covers the whole workspace, which is
# the only way a new app cannot quietly ship a .env.production.
.env*
!.env.example
!.env.*.example
.env.backup
*.env.bak

# ---------- IDE / Editors ----------
# VS Code (keep extensions.json and recommended settings only)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains
.idea/
*.iml
*.iws

# Sublime
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

