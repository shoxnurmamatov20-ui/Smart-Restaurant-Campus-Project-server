{
  "name": "@restaurant/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Shared i18n messages (uz / ru / en) for Smart Restaurant Campus apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./messages/uz": "./messages/uz.json",
    "./messages/ru": "./messages/ru.json",
    "./messages/en": "./messages/en.json",
    "./order-state": "./src/order-state.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@restaurant/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
