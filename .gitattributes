# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.php text eol=lf
*.py text eol=lf
*.go text eol=lf
*.rs text eol=lf
*.java text eol=lf
*.sh text eol=lf

# Config
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf

# Docs
*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf

# Windows-specific
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.wav binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Lock files - don't merge automatically
package-lock.json -diff
pnpm-lock.yaml -diff
yarn.lock -diff
composer.lock -diff
uv.lock -diff
