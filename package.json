{
  "name": "restaurant-campus",
  "version": "0.0.0",
  "private": true,
  "description": "Smart Restaurant Campus \u2014 restoranlar uchun yagona raqamli boshqaruv platformasi (monorepo)",
  "author": "uzbcorp@gmail.com",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,yml,yaml,css}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "api:install": "cd apps/api && composer install",
    "api:migrate": "cd apps/api && php artisan migrate",
    "api:seed": "cd apps/api && php artisan db:seed",
    "api:fresh": "cd apps/api && php artisan migrate:fresh --seed",
    "api:test": "cd apps/api && php artisan test",
    "ai:install": "cd apps/ai-services && uv sync",
    "ai:dev": "cd apps/ai-services && uv run uvicorn src.main:app --reload --port 8001",
    "ai:test": "cd apps/ai-services && uv run pytest",
    "prepare": "husky",
    "load": "node infrastructure/load/run.mjs --base http://127.0.0.1 --host mypos.tashmedunitf.uz --users 30 --seconds 30"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml,css}": [
      "prettier --write"
    ],
    "apps/api/**/*.php": [
      "php apps/api/vendor/bin/pint --config apps/api/pint.json --dirty"
    ],
    "apps/ai-services/**/*.py": [
      "uv --directory apps/ai-services run ruff check --fix",
      "uv --directory apps/ai-services run ruff format"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.1.5"
    }
  }
}
