# ============================================================
# Smart Restaurant Campus
# Environment variables example
# ============================================================
# Copy this file to .env and fill in the values.
# Each app (web/admin/api/ai-services) has its own .env.example
# This root .env.example is a master reference.
# ============================================================

# ============ APPLICATION ============
APP_NAME="Smart Restaurant Campus"
APP_ENV=local                       # local | staging | production
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tashkent

# ============ FRONTEND (apps/web, apps/admin) ============
NEXT_PUBLIC_APP_NAME=Smart Restaurant Campus
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# NextAuth / Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                    # openssl rand -base64 32

# ============ DATABASE (PostgreSQL) ============
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=restaurant_campus
DB_USERNAME=restaurant_campus
DB_PASSWORD=changeme
DB_URL=postgresql://restaurant_campus:changeme@localhost:5432/restaurant_campus

# ============ REDIS ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ============ CLICKHOUSE (analytics) ============
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=restaurant_analytics
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# ============ MINIO / S3 (object storage) ============
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=restaurant-campus
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# ============ KEYCLOAK (SSO) ============
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=restaurant-campus
KEYCLOAK_CLIENT_ID=restaurant-campus-web
KEYCLOAK_CLIENT_SECRET=

# ============ TENANCY ============
TENANCY_MODE=single_database
TENANCY_HEADER=X-Tenant
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,restaurant-campus.uz
TENANCY_DEFAULT_SLUG=demo-restaurant
TENANCY_REQUIRE_TENANT=false

# ============ MAIL (SMTP / Mailhog dev) ============
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@restaurant-campus.uz"
MAIL_FROM_NAME="Smart Restaurant Campus"

# ============ QUEUE / BROADCAST ============
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ============ LARAVEL REVERB (WebSocket) ============
REVERB_APP_ID=restaurant-campus-app
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ============ SANCTUM ============
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001
SESSION_DOMAIN=localhost

# ============ FISCAL MODULE (O'zbekiston onlayn-kassa) ============
# Every cash payment must produce a fiscal receipt. Without these the POS
# can take money but cannot legally close a shift.
FISCAL_PROVIDER=                    # multikassa | soliq | none
FISCAL_API_URL=
FISCAL_TERMINAL_ID=
FISCAL_TOKEN=

# ============ DELIVERY AGGREGATORS ============
YANDEX_EATS_API_URL=
YANDEX_EATS_TOKEN=
EXPRESS24_API_URL=
EXPRESS24_TOKEN=
UZUM_TEZKOR_API_URL=
UZUM_TEZKOR_TOKEN=

# ============ E-IMZO (supplier contracts) ============
EIMZO_API_URL=https://e-imzo.uz
EIMZO_CLIENT_ID=
EIMZO_CLIENT_SECRET=

# ============ PAYMENT GATEWAYS ============
# Payme
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_API_URL=https://checkout.paycom.uz

# Click
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_API_URL=https://api.click.uz

# Uzum
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
UZUM_API_URL=https://api.uzum.uz

# ============ SMS GATEWAY ============
ESKIZ_API_URL=https://notify.eskiz.uz
ESKIZ_API_TOKEN=
ESKIZ_FROM=4546

# ============ AI / LLM ============
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-6
AI_FALLBACK_MODEL=gpt-4o-mini

# ============ MONITORING ============
SENTRY_DSN=
LOG_CHANNEL=stack
LOG_LEVEL=debug
PROMETHEUS_METRICS_ENABLED=true

# ============ SEARCH (Meilisearch) ============
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# ============ FEATURE FLAGS ============
FEATURE_MOBILE_APP=false           # Phase 2
FEATURE_AI_MENU_ASSISTANT=false    # Phase 2
FEATURE_DEMAND_FORECAST=false      # Phase 2
FEATURE_FACE_ATTENDANCE=true       # Staff clock-in via Face ID
FEATURE_QR_MENU=true               # Guest-facing QR menu
FEATURE_DELIVERY=true
FEATURE_AGGREGATORS=false          # Yandex Eats / Express24 / Uzum Tezkor
