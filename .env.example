# ============================================================
# CAMPUS — Smart Campus Platform
# Environment variables example
# ============================================================
# Copy this file to .env and fill in the values.
# Each app (web/admin/api/ai-services) has its own .env.example
# This root .env.example is a master reference.
# ============================================================

# ============ APPLICATION ============
APP_NAME="CAMPUS"
APP_ENV=local                       # local | staging | production
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tashkent

# ============ FRONTEND (apps/web, apps/admin) ============
NEXT_PUBLIC_APP_NAME=CAMPUS
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# NextAuth / Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                    # openssl rand -base64 32

# ============ DATABASE (PostgreSQL) ============
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=campus
DB_USERNAME=campus
DB_PASSWORD=changeme
DB_URL=postgresql://campus:changeme@localhost:5432/campus

# ============ REDIS ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ============ CLICKHOUSE (analytics) ============
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=campus_analytics
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# ============ MINIO / S3 (object storage) ============
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=campus
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# ============ KEYCLOAK (SSO) ============
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=campus
KEYCLOAK_CLIENT_ID=campus-web
KEYCLOAK_CLIENT_SECRET=

# ============ MAIL (SMTP / Mailhog dev) ============
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@campus.uz"
MAIL_FROM_NAME="CAMPUS"

# ============ QUEUE / BROADCAST ============
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ============ LARAVEL REVERB (WebSocket) ============
REVERB_APP_ID=campus-app
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ============ SANCTUM ============
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001
SESSION_DOMAIN=localhost

# ============ HEMIS INTEGRATION (Uzbek higher-ed system) ============
HEMIS_API_URL=https://hemis.uz/api
HEMIS_API_KEY=
HEMIS_UNIVERSITY_ID=

# ============ E-IMZO (Uzbek e-signature) ============
EIMZO_API_URL=https://e-imzo.uz
EIMZO_CLIENT_ID=
EIMZO_CLIENT_SECRET=

# ============ PAYMENT GATEWAYS ============
# Payme
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_API_URL=https://checkout.paycom.uz

# Click
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_API_URL=https://api.click.uz

# ============ SMS GATEWAY ============
ESKIZ_API_URL=https://notify.eskiz.uz
ESKIZ_API_TOKEN=
ESKIZ_FROM=4546

# ============ AI / LLM ============
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-6
AI_FALLBACK_MODEL=gpt-4o-mini

# ============ MONITORING ============
SENTRY_DSN=
LOG_CHANNEL=stack
LOG_LEVEL=debug
PROMETHEUS_METRICS_ENABLED=true

# ============ SEARCH (Meilisearch) ============
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# ============ FEATURE FLAGS ============
FEATURE_MOBILE_APP=false           # Phase 2
FEATURE_AI_CHATBOT=false           # Phase 2
FEATURE_FACE_RECOGNITION=true
FEATURE_VIDEO_CONFERENCING=true
